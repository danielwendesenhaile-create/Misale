{
  "name": "misale",
  "version": "1.0.0",
  "description": "Misale (ምሳሌ) — Premium Ethiopian/Habesha dating app",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "seed": "node src/seed/seed.js",
    "db:migrate": "supabase db push",
    "db:reset": "supabase db reset",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "lint:sql": "node scripts/validate-sql.js",
    "check:fn": "node scripts/check-edge-function.js",
    "check:action": "node scripts/check-record-action.js",
    "check:admin": "node scripts/check-admin-verify.js"
  },
  "dependencies": {
    "@expo-google-fonts/noto-serif-ethiopic": "^0.3.0",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/stack": "^6.4.1",
    "@supabase/supabase-js": "2.45.0",
    "dotenv": "^16.4.0",
    "expo": "~52.0.46",
    "expo-font": "~13.0.3",
    "expo-linear-gradient": "~13.0.2",
    "expo-splash-screen": "^0.29.24",
    "expo-status-bar": "~2.0.1",
    "nativewind": "^4.2.6",
    "react": "18.3.1",
    "react-native": "^0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.7",
    "react-native-safe-area-context": "^4.12.0",
    "react-native-screens": "~4.4.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~18.3.12",
    "@types/react-native": "^0.73.0",
    "supabase": "^1.200.0",
    "typescript": "^5.9.3"
  },
  "private": true
}
