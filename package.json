{
  "name": "misale",
  "version": "1.0.0",
  "description": "Misale (ምሳሌ) — Premium Ethiopian/Habesha dating app",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "seed": "node src/seed/seed.js",
    "db:migrate": "supabase db push",
    "db:reset": "supabase db reset",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "lint:sql": "node scripts/validate-sql.js",
    "check:fn": "node scripts/check-edge-function.js",
    "check:action": "node scripts/check-record-action.js",
    "check:admin": "node scripts/check-admin-verify.js"
  },
  "dependencies": {
    "@expo-google-fonts/noto-serif-ethiopic": "^0.3.0",
    "@expo/metro-runtime": "~6.1.2",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/stack": "^6.4.1",
    "@supabase/supabase-js": "2.45.0",
    "dotenv": "^16.4.0",
    "expo": "^54.0.35",
    "expo-font": "~14.0.12",
    "expo-linear-gradient": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "nativewind": "^4.2.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-worklets": "0.5.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.1.10",
    "@types/react-native": "^0.73.0",
    "supabase": "^1.200.0",
    "typescript": "^5.9.3"
  },
  "private": true
}
