# ── Expo client variables (MUST have EXPO_PUBLIC_ prefix) ─────────────────────
# Get these from: Supabase Dashboard → Settings → API

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Server-only (Edge Functions, seed scripts — never in the mobile bundle) ────
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Local dev override (supabase start) ───────────────────────────────────────
# EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key-here

NODE_ENV=development
